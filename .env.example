# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno para ms-andesstay-notify
# Copia este archivo a .env (NO se sube a Git) y completa con los valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# Profile de Spring Boot (prod para cloud / EC2, dev para local sin JWT)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082

# ─── Seguridad OAuth2 / JWT (AWS Cognito) ─────────────────────────────────────
# Región de AWS donde está el User Pool de Cognito
COGNITO_REGION=us-east-1
# ID del User Pool de Cognito (ej. us-east-1_aBcDeFgHi)
COGNITO_USER_POOL_ID=us-east-1_CHANGE_ME
# App Client ID del User Pool (sin secret; se valida contra el claim client_id)
COGNITO_APP_CLIENT_ID=CHANGE_ME

# ─── Base de Datos Cloud (AWS RDS PostgreSQL / MySQL) ────────────────────────
# Opción A: URL completa JDBC
# DB_URL=jdbc:postgresql://tu-instancia.xxxxxx.us-east-1.rds.amazonaws.com:5432/andesstay_notify
# Opción B: Parámetros individuales (por defecto se arma el JDBC URL con estos)
DB_HOST=tu-instancia.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=andesstay_notify
DB_USER=postgres
DB_PASS=cambia_esto_por_tu_password_segura

# ─── Broker RabbitMQ (AWS EC2 o Amazon MQ) ───────────────────────────────────
RABBIT_HOST=tu-broker-rabbit-o-ip-ec2
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_VHOST=/

# ─── CORS (Frontend Angular / BFF) ───────────────────────────────────────────
# Permite todos con '*' o una lista separada por comas
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# ─── JVM Tuning (opcional para EC2 t2.micro / t3.micro) ──────────────────────
JAVA_OPTS=-Xms256m -Xmx512m
