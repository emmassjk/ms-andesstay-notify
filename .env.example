# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno para ms-andesstay-notify (Docker Desktop)
# Copia este archivo a .env (NO se sube a Git) y ajusta los valores si lo necesitas.
# ─────────────────────────────────────────────────────────────────────────────

# Profile de Spring Boot:
#   - dev  : Desarrollo local sin JWT (permite todas las peticiones sin token).
#   - prod : Activa validación obligatoria de JWT contra AWS Cognito.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082

# ─── Base de Datos Local (PostgreSQL en Docker Desktop) ──────────────────────
# Por defecto se conecta al contenedor 'db' en docker-compose
DB_HOST=db
DB_PORT=5432
DB_NAME=andesstay_notify
DB_USER=postgres
DB_PASS=postgres

# ─── Broker RabbitMQ Local (Docker Desktop) ──────────────────────────────────
# Por defecto se conecta al contenedor 'rabbitmq' en docker-compose
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_VHOST=/

# ─── Seguridad OAuth2 / JWT (AWS Cognito) ─────────────────────────────────────
# Requerido únicamente si se utiliza SPRING_PROFILES_ACTIVE=prod
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_CHANGE_ME
COGNITO_APP_CLIENT_ID=CHANGE_ME

# ─── CORS (Frontend Angular / BFF) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8080,http://localhost:8081

# ─── JVM Tuning para contenedor ──────────────────────────────────────────────
JAVA_OPTS=-Xms256m -Xmx512m
