# Copia este archivo a .env (NO se sube a Git) y completa los valores.
# Uso con Docker:  docker run -d --name notify -p 8082:8082 --env-file .env ms-andesstay-notify
SPRING_PROFILES_ACTIVE=prod
JWT_ISSUER_URI=https://login.microsoftonline.com/TU_TENANT_ID/v2.0
DB_HOST=tu-instancia.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=andesstay_notify
DB_USER=postgres
DB_PASS=cambia_esto
RABBIT_HOST=ip-o-dns-de-la-ec2-de-rabbit
